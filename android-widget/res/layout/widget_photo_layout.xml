<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================
     DeepSync Photo Frame — Cyberpunk HUD Frame (4x3 ~ 5x5)
     写真の全体表示(fitCenter)とリッチなサイバーHUDの調和
     =================================================== -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#E60A0A0E">

    <!-- 全体写真 (アスペクト比維持・見切れ防止) -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitCenter"
        android:padding="2dp"
        android:contentDescription="DeepSync Large Photo"
        android:src="@drawable/slide_2" />

    <!-- 上部サイバーHUDステータスバー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:orientation="horizontal"
        android:background="#D90A0A0E"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="HUD // PHOTO STREAM [1/124]"
            android:textColor="#00F2FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:ellipsize="end"
            android:maxLines="1" />

        <TextView
            android:id="@+id/widget_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONO // 25:00 [FOCUS]"
            android:textColor="#00F2FF"
            android:textSize="9sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- 下部サイバーHUD情報バー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:background="#E60A0A0E"
        android:paddingStart="10dp"
        android:paddingEnd="10dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Live Photo Telemetry"
            android:textColor="#C0D0E0"
            android:textSize="10sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:paddingEnd="8dp" />

        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm:ss"
            android:format12Hour="HH:mm:ss"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            android:shadowColor="#00F2FF"
            android:shadowRadius="6" />
    </LinearLayout>

</RelativeLayout>
