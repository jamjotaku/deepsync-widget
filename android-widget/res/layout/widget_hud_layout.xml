<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================
     DeepSync HUD — Android Home Screen Widget Layout
     サイバーパンクHUD調 ホーム画面常駐ウィジェット
     =================================================== -->
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="8dp"
    android:background="#E60A0A0E">

    <!-- ネオンシアンのサイバーコーナー枠 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/transparent" />

    <!-- 左側: メディアスライドショー サムネイル -->
    <ImageView
        android:id="@+id/widget_image"
        android:layout_width="100dp"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:contentDescription="DeepSync Media" />

    <!-- 右側: HUDテレメトリ & 時計 & タイマー -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_toEndOf="@id/widget_image"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="4dp"
        android:gravity="center_vertical">

        <!-- ヘッダーバッジ -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="HUD // DEEPSYNC"
            android:textColor="#00F2FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />

        <!-- デジタル時計 -->
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm:ss"
            android:format12Hour="hh:mm:ss a"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:shadowColor="#00F2FF"
            android:shadowRadius="6" />

        <!-- ポモドーロステータス -->
        <TextView
            android:id="@+id/widget_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONO: 25:00 [FOCUS]"
            android:textColor="#00F2FF"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

        <!-- 投稿者 / キャプション -->
        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Live Sync Telemetry"
            android:textColor="#65859E"
            android:textSize="8sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</RelativeLayout>
