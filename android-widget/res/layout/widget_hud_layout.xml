<?xml version="1.0" encoding="utf-8"?>
<!-- ===================================================
     DeepSync HUD — Android Standard Responsive Widget (3x2 ~ 5x3)
     写真とHUD情報が黄金比(4:5)で柔軟に追従するレスポンシブ設計
     =================================================== -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="#E60A0A0E"
    android:padding="8dp">

    <!-- 左側: メディアスライドショー (比率 4) -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="4">

        <ImageView
            android:id="@+id/widget_image"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:contentDescription="DeepSync Media"
            android:src="@drawable/slide_1" />

        <!-- 左上オーバーレイ HUD インジケーター -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:layout_alignParentStart="true"
            android:background="#CC0A0A0E"
            android:paddingStart="4dp"
            android:paddingEnd="4dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:text="HUD // LIVE"
            android:textColor="#00F2FF"
            android:textSize="7sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 右側: HUDテレメトリ & 時計 & タイマー (比率 5) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="5"
        android:orientation="vertical"
        android:paddingStart="10dp"
        android:paddingEnd="6dp"
        android:gravity="center_vertical">

        <!-- ヘッダーバッジ -->
        <TextView
            android:id="@+id/widget_badge"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="HUD // DEEPSYNC [1/124]"
            android:textColor="#00F2FF"
            android:textSize="9sp"
            android:textStyle="bold"
            android:letterSpacing="0.06"
            android:ellipsize="end"
            android:maxLines="1" />

        <!-- リアルタイムデジタル時計 (24時間表記) -->
        <TextClock
            android:id="@+id/widget_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:format24Hour="HH:mm:ss"
            android:format12Hour="HH:mm:ss"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:shadowColor="#00F2FF"
            android:shadowRadius="8"
            android:layout_marginTop="2dp" />

        <!-- ポモドーロステータス -->
        <TextView
            android:id="@+id/widget_pomodoro"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CHRONO // 25:00 [FOCUS]"
            android:textColor="#00F2FF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:layout_marginTop="2dp" />

        <!-- キャプション -->
        <TextView
            android:id="@+id/widget_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Synchronized Telemetry Stream"
            android:textColor="#9EBFDB"
            android:textSize="9sp"
            android:maxLines="2"
            android:ellipsize="end"
            android:layout_marginTop="2dp" />
    </LinearLayout>

</LinearLayout>
