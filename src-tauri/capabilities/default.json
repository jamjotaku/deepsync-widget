{
  "identifier": "default",
  "description": "DeepSync Widget default capabilities",
  "windows": ["main"],
  "remote": {
    "urls": [
      "https://jamjotaku.github.io/deepsync-widget/*",
      "https://*.vercel.app/*"
    ]
  },
  "permissions": [
    "core:default",
    "core:window:default",
    "core:window:allow-start-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-always-on-top",
    "core:window:allow-close",
    "core:window:allow-minimize",
    "core:window:allow-center",
    "shell:allow-open"
  ]
}
